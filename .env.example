# Copy this file to .env and fill in real values. Never commit .env.

# HubSpot app credentials (from the app's Auth tab, see details.md §1)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/oauth/callback

# Local database (SQLite for dev; swap to a Postgres URL for production)
DATABASE_URL=sqlite+aiosqlite:///./local.db

# Base URL this service is reachable at (used to build webhook target URLs, e.g. an ngrok URL)
APP_BASE_URL=http://localhost:8000

# Set to false ONLY if you're on a network with a TLS-inspecting proxy (e.g.
# corporate Netskope/Zscaler) that breaks certificate verification for
# outbound HTTPS calls. Never set false outside local dev.
HTTPX_VERIFY_SSL=true
